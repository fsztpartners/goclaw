{
  "family": "goclaw",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::506953261627:role/goclaw-task-execution",
  "taskRoleArn": "arn:aws:iam::506953261627:role/goclaw-task",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "containerDefinitions": [
    {
      "name": "goclaw",
      "image": "506953261627.dkr.ecr.us-east-1.amazonaws.com/goclaw:PLACEHOLDER",
      "essential": true,
      "portMappings": [
        { "containerPort": 18790, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "GOCLAW_PORT", "value": "18790" },
        { "name": "GOCLAW_HOST", "value": "0.0.0.0" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:506953261627:secret:goclaw/prod:DATABASE_URL::" },
        { "name": "GOCLAW_ANTHROPIC_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:506953261627:secret:goclaw/prod:GOCLAW_ANTHROPIC_API_KEY::" },
        { "name": "GOCLAW_DEFAULT_MODEL", "valueFrom": "arn:aws:secretsmanager:us-east-1:506953261627:secret:goclaw/prod:GOCLAW_DEFAULT_MODEL::" },
        { "name": "GOCLAW_ENCRYPTION_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:506953261627:secret:goclaw/prod:GOCLAW_ENCRYPTION_KEY::" },
        { "name": "GOCLAW_GATEWAY_TOKEN", "valueFrom": "arn:aws:secretsmanager:us-east-1:506953261627:secret:goclaw/prod:GOCLAW_GATEWAY_TOKEN::" },
        { "name": "GOCLAW_LLM_PROVIDER", "valueFrom": "arn:aws:secretsmanager:us-east-1:506953261627:secret:goclaw/prod:GOCLAW_LLM_PROVIDER::" },
        { "name": "GOCLAW_POSTGRES_DSN", "valueFrom": "arn:aws:secretsmanager:us-east-1:506953261627:secret:goclaw/prod:GOCLAW_POSTGRES_DSN::" },
        { "name": "GOCLAW_TENANT", "valueFrom": "arn:aws:secretsmanager:us-east-1:506953261627:secret:goclaw/prod:GOCLAW_TENANT::" },
        { "name": "GOCLAW_USER_ID", "valueFrom": "arn:aws:secretsmanager:us-east-1:506953261627:secret:goclaw/prod:GOCLAW_USER_ID::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/goclaw",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "goclaw"
        }
      }
    }
  ]
}
